{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 249.49,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 10.72,
          "text": "تو دوره مدرسه، وقتی معلم ما رو صدا میزد، هیچ وقت پامون رو نمیذاشیم رو نیمکت اول، نیمکت دوم، نیمکت ثوم، تا به میز معلم برسیم",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 10.72,
          "end": 19.18,
          "text": "در حالی که خود اون معلم به ما آموزش داده بود که کوتاهترین راه، مستقیمترین راهه",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 19.18,
          "end": 25.2,
          "text": "پس ما به سادگی میتونستیم مستقیمترین راه و کوتاهترین راه انتخاب کنیم",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 25.2,
          "end": 31.26,
          "text": "اما اینکار رو نمیکردیم چون اگر اینکار رو میکردیم مطمئنن معلم ما رو از کلاس میداختید",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 40.99,
          "end": 46.63,
          "text": "سلام خوش اومدیم به هفته چهارم از برنامه عموزشی سواد مالی",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 47.71,
          "end": 54.39,
          "text": "یکی از مهمترین بحث ها در سواد مالی قرض و اعتباره",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 54.39,
          "end": 61.69,
          "text": "یکی از مشکلترین موضوعات سواد مالی اصولا همین قرض و اعتباره و یک ویژگی های خاصی داره",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 61.69,
          "end": 67.21,
          "text": "ببینید ما در پسنداز که با هم در بارش صحبت کردیم",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 67.21,
          "end": 70.59,
          "text": "پولمون رو از امروز میفرستیم به آینده",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 70.59,
          "end": 76.11,
          "text": "ولی در قرض داریم از آینده میاریم به زمان حال و خرجش میکنیم",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 76.11,
          "end": 77.41,
          "text": "یک تفاوت عمده است",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 77.41,
          "end": 82.37,
          "text": "آیندهی که ما میخواستیم توی پلکان توامندی مالی بالا بریم",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 82.37,
          "end": 87.79,
          "text": "یعنی گفتیم با صندوق استراری بریم روی پله امنیت مالی وایسیم",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 87.79,
          "end": 95.55,
          "text": "با پسندازهای کتاه مدت و بلند مدت و سرمایه گذاری بریم رو آزادی مالی بیستیم",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 95.55,
          "end": 99.47,
          "text": "و برای اینکه بتونیم این دوتار رو محقق بکنیم",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 99.47,
          "end": 103.73,
          "text": "کلی در در سر اصلاح الگوهای خرید رو داشتیم",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 103.73,
          "end": 109.23,
          "text": "تصمیم گیری های مالی که این نیازه یا خواسته است درامدزایه یا هزینزایه",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 109.23,
          "end": 115.19,
          "text": "همه این کارها رو میکردیم که بتونیم اهداف مالیمون رو در آینده محقق بکنیم",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 115.19,
          "end": 120.25,
          "text": "حالا قرض یک کاری میکنه که ما پول رو از آینده بیاریم به زمان حال",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 120.25,
          "end": 125.85,
          "text": "و در واقع حالش رو ببریم در صورتی که آینده به اون نیاز داریم",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 125.85,
          "end": 130.25,
          "text": "خب این یکی که از مهمترین موضوعات سواد مالیه",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 130.25,
          "end": 135.37,
          "text": "که چطور امکان داره که بخواهیم آیندهی که این همه براش برنامه داریم",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 135.37,
          "end": 141.27,
          "text": "و یه پولی هم از اونجا، یه منبعی هم از اونجا وردنیم و بیان در زمان حال خرجش بکنیم",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 141.27,
          "end": 149.07,
          "text": "حتی بسیاری از برنامه های سواد مالی در دنیا با رحای از بدهی آغاز می شه",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 149.07,
          "end": 156.43,
          "text": "یعنی برنامهی که مشاور به شما پیشنهاد می دهی که ابتدا قرض گرفتن رو متوقف کنی",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 156.43,
          "end": 163.87,
          "text": "یا اگر اعتیاد به قرض گرفتن پیدا کنی راهکارهای رحای از بدهی بهت پیشنهاد می ده",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 163.87,
          "end": 169.43,
          "text": "و حتی انجامنی هست، انجامن بدهکاران گمنام، ماننده الکولی های گمنام",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 169.43,
          "end": 174.81,
          "text": "در دوازده قدم افراد آموزش میده که از بدهی رها بشن",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 174.81,
          "end": 184.43,
          "text": "ببیش این که در جامعه بین المللی کارت های اعتباری که همون یه جوری بدهکار شدنه خیلی مرسومه",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 184.43,
          "end": 191.51,
          "text": "بنابراین اونجا خیلی جدیتر و به عنوان اولین گام به رهای از بدهی میپردازن",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 191.51,
          "end": 200.45,
          "text": "خب پس این هفته یکی از مهمترین موضوعات سواد مالی رو میخواییم با شما مطرح بکنیم",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 200.45,
          "end": 206.59,
          "text": "و این که خب چه کار بکونیم؟ به هر حال ما یه سری نیازها و خواسته هایی داریم که الان براش پول ندارید",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 206.59,
          "end": 213.45,
          "text": "که الان براش پول نداریم. آیا راهی هست؟ آیا سواد مالی پیشنهادی به ما داره یا نه؟",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 214.23,
          "end": 220.79,
          "text": "خب با توجه به همین مطالبی که ارز کردم پاسخ اول یه سواد مالی اینه که سبر کنیم",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 220.79,
          "end": 232.05,
          "text": "سبر به معنای این که، نه این که زج رو بکشیم، بگیم که آخ چرا ندارم، حالا پول رو چی کار بکنم، این کالا رو میخوام و ندارم",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 232.05,
          "end": 238.87,
          "text": "سبر به این معنای که، و نه حتی سبر بکنیم که بلاخره یه روزی بهش برسیم",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 238.87,
          "end": 246.21,
          "text": "سبر به معنای قناعت کردن، یک مفهوم جهانیه، لزومن یک مفهوم دینی هم نیست",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 246.21,
          "end": 249.49,
          "text": "البته رنگ دینی هم داره این قناعت کردن",
          "review_item_id": "segment-0038"
        }
      ]
    },
    {
      "id": 2,
      "start": 249.49,
      "end": 487.49,
      "segments": [
        {
          "segment_id": 39,
          "start": 249.49,
          "end": 252.97,
          "text": "اما واقعا اینه که سروت در قناعته",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 252.97,
          "end": 257.07,
          "text": "سبر به این معنی که به آنچه که داریم بسنده بکنیم",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 257.07,
          "end": 261.05,
          "text": "ببینید دو تا فلسفه زندگی وجود داره",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 261.05,
          "end": 267.57,
          "text": "یکی فلسفه داشتن که به ما میگه که برای رشد و کمال",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 267.57,
          "end": 270.85,
          "text": "برای اینکه یک شخصیت توصیح یافته داشته باشی",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 270.85,
          "end": 273.33,
          "text": "لازمه که به دست بیاری",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 273.33,
          "end": 275.49,
          "text": "اگر شغل خوبی به دست بیاری",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 275.49,
          "end": 277.07,
          "text": "ماشین خوبی داشته باشی",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 277.07,
          "end": 278.99,
          "text": "همسر مناسبی داشته باشی",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 278.99,
          "end": 288.53,
          "text": "ویلا داشته باشی، لپتاب داشته باشی، همه داشتنها رو هرچی بیشتر داشته باشی پس تو انسان رشدی آفته تری هستی",
          "review_item_id": "segment-0048"
        },
        {
          "segment_id": 49,
          "start": 288.53,
          "end": 292.13,
          "text": "بنابراین وارد مسابقی داشتن میشی",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 293.25,
          "end": 297.01,
          "text": "خب فلسفه دوم چیه؟ فلسفه بودنه",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 297.01,
          "end": 301.85,
          "text": "میگه این نیست که شما هرچقد بیشتر داشته باشی رشدی آفته تری",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 301.85,
          "end": 306.09,
          "text": "بلکه هرچه بیشتر باشی رشدی آفته تری",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 306.09,
          "end": 309.23,
          "text": "بودن به یک سری صفات برمیگرده",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 309.23,
          "end": 315.71,
          "text": "مثل مهربان بودن، بخشنده بودن، دقیق بودن، درست بودن",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 315.71,
          "end": 318.97,
          "text": "میگن فلسفه زندگی بودنه نداشتن",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 318.97,
          "end": 324.19,
          "text": "بنابراین حتی اگه یادتون باشه تو اون صندوق یاری دیگران",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 324.19,
          "end": 329.33,
          "text": "ارز کردم خدمتون مهم اینه که حتی درصد کمی هم به این دهندگی تخصیص بدیم",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 329.33,
          "end": 332.61,
          "text": "چونه یه نوع بودنه، مسئله این نیست که چقدره",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 332.61,
          "end": 335.91,
          "text": "یک نوع بودنی رو در انسان شکل میده",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 335.91,
          "end": 343.89,
          "text": "فلسفه بودن میگه شما باید یک جوری باشی و این بودن شما ربطی به این نداره که چی داشته باشی یا چی نداشته باشی",
          "review_item_id": "segment-0060"
        },
        {
          "segment_id": 61,
          "start": 344.41,
          "end": 357.85,
          "text": "پس اصولاً چون سواد مالی هم یک موضوع بین رشده ایه اینجا پیشنهاد میده که قناعت کنی و قناعت به معنای پیروی از فلسفه بودنه نه فلسفه داشتن",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 357.85,
          "end": 367.23,
          "text": "فکر نکن اونو به دست بیاری اون کالا رو پس کمالیافته تر یا رشدیافته تر از خودت خواهی بود",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 367.23,
          "end": 371.73,
          "text": "و جلوتر میری از این چیزی که هستیه کمی پیشرفت میکنی، نلوزومن",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 371.73,
          "end": 378.45,
          "text": "چون به سادگی ما میدونیم که اون کالا یا اون محصول یا اون خدمت به راحتی جزو ما میشه",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 378.45,
          "end": 384.53,
          "text": "و دیگه ما خودمون اون رو جزو خودمون ارزیابی میکنیم و میریم سراغ یه هدف دیگه",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 384.53,
          "end": 390.37,
          "text": "یه مثال مثلا عزیزانی که در شمال کشور زندگی میکنن",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 390.37,
          "end": 393.51,
          "text": "شمال برای اونها جزو خودشونه",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 393.51,
          "end": 396.69,
          "text": "اون آب و هوا، اون تراوت، اون سبزی",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 396.69,
          "end": 400.17,
          "text": "جزو وجود اونهاست، جزو زندگیشونه",
          "review_item_id": "segment-0069"
        },
        {
          "segment_id": 70,
          "start": 400.17,
          "end": 402.85,
          "text": "دیگه احساس نمیکنن یه جای خیلی خاصی هست",
          "review_item_id": "segment-0070"
        },
        {
          "segment_id": 71,
          "start": 402.85,
          "end": 407.19,
          "text": "ولی برای دیگران شمال یه جای پرتراوته",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 407.19,
          "end": 411.37,
          "text": "یعنی چون برای ما یک مقصده و اونجا حضور نداریم",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 411.37,
          "end": 413.63,
          "text": "فکر میکنیم اونجا یه خبرهایه",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 413.63,
          "end": 417.61,
          "text": "ولی برای خود اونها چون جزوشون شده خبری نیست شهرشونه",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 417.61,
          "end": 424.21,
          "text": "و ما هم اگر بنیم یه مدت اونجا زندگی بکنیم دیگه اون تراوت و شادابی اونها جزو ما میشه",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 424.21,
          "end": 430.11,
          "text": "ما دیگه احساس نمیکنیم یه حرکت خاصی کردیم یا یه تراوت جدیدی وارد زندگیمون شده",
          "review_item_id": "segment-0076"
        },
