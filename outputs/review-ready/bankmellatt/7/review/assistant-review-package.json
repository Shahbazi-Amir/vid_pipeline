      "end": 951.77,
      "segments": [
        {
          "segment_id": 168,
          "start": 717.09,
          "end": 719.47,
          "text": "داشته های اونجوری داشته باشم",
          "review_item_id": "segment-0168"
        },
        {
          "segment_id": 169,
          "start": 719.47,
          "end": 723.45,
          "text": "من باید رفتار و نوع بودن هم یه جوری خاصی باشه",
          "review_item_id": "segment-0169"
        },
        {
          "segment_id": 170,
          "start": 723.45,
          "end": 727.41,
          "text": "تا نشون بدم عضو یک گروه یا یک طبقه اجتماعی هستم",
          "review_item_id": "segment-0170"
        },
        {
          "segment_id": 171,
          "start": 727.41,
          "end": 731.71,
          "text": "لزومم به دواقع میزان داشته هام نیست",
