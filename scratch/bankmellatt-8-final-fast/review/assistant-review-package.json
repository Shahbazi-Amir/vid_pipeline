{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.05,
      "end": 279.18,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.05,
          "end": 9.23,
          "text": "تفاوت فقیر با یک ثروت من در چی؟ من مطبعنم در میزان پولی که دارن نیست",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 18.64,
          "end": 24.24,
          "text": "سلام، تا اینجا راجب خرج کردن و الگوهای نمناسب خرید صحبت کردیم",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 24.24,
          "end": 31.88,
          "text": "یکی از مهمترین ایارهای تصمیم گیری برای که ما وارده خرید بشیم یا نشیم",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 31.88,
          "end": 34.36,
          "text": "نگاه کردن به اون داراییه",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 34.36,
          "end": 36.46,
          "text": "ببینیم ما چی میخواییم بخریم",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 36.46,
          "end": 41.96,
          "text": "حالا نه خرید خوردریزهایی که در طول روز مثلا مورد استفاده ما قرار میگیری",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 41.96,
          "end": 45.5,
          "text": "یا در طول ماه داریم زندگیمونو با هاش میگذرونیم",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 45.5,
          "end": 51.6,
          "text": "ولی باید یه توجهی بکنیم نسبت به اون دارایی که داریم ایجاد میکنیم",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 51.6,
          "end": 56.04,
          "text": "ما با خرید کردن یه دارایی رو کست میکنیم، یه داشتهی داریم",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 56.04,
          "end": 59.84,
          "text": "باید بهش نگاه بکنیم که این ماهیت این دارایی چیه",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 59.84,
          "end": 65.02,
          "text": "فرض کنید الان یه مرور ذهنی به دارایاتون داشته باشید",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 65.02,
          "end": 71.84,
          "text": "مثلا من میگم خب یه ماشین دارم، یه خونه، تلفون همراه، کیف، لباس هم",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 71.84,
          "end": 76.3,
          "text": "یه سری دارایی دارم، فرش خونه، تابلوهایی که تو خونه دارم",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 76.3,
          "end": 82.56,
          "text": "خب اینا دارایی هن ولی یک ماهیت خاصی دارن",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 82.56,
          "end": 86.24,
          "text": "آیا من با این دارایی ها سروتمندم؟",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 87.44,
          "end": 90.13,
          "text": "اندیشه سروتمندی میگه نه",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 91.02,
          "end": 99.34,
          "text": "میگه تو با داشتن این دارایی ها مثل ماشین، خونه، تلفون همراه، لباس، فرش، تابل و فرش، هرچی",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 99.34,
          "end": 103.28,
          "text": "لزومن تو سروتمند نیستی",
          "review_item_id": null
        },
        {
          "segment_id": 19,
          "start": 103.28,
          "end": 105.4,
          "text": "بلکه ممکنه فقیر باشی",
          "review_item_id": null
        },
        {
          "segment_id": 20,
          "start": 105.96,
          "end": 110.34,
          "text": "چطوری؟ باید نگاه بکنی این دارایی که داری",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 110.34,
          "end": 114.52,
          "text": "یا این دارایی که میخوای ایجاد بکنی، پول بدی، بخری",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 114.52,
          "end": 118.54,
          "text": "آیا درامتزاه یا هزینه ذاه؟",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 119.46,
          "end": 123.5,
          "text": "اگر درامتزاه، بله، تو اندیشه فروتمندی داری",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 124.7,
          "end": 131.6,
          "text": "ولی اگر هزینه ذاه، نه، تو فقیری و اندیشه فقر داری",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 132.52,
          "end": 137.22,
          "text": "یعنی چی ببینیم، مالا از ماشینم هم، هیچ درامتی کست نمی کنم",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 137.22,
          "end": 142.52,
          "text": "فقط یه زندگی داریم، بهاش یه راحتی دارم",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 142.52,
          "end": 145.06,
          "text": "ولی درامدی ازش ندارم",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 145.06,
          "end": 148.48,
          "text": "این درامدزایی برای من نمی کنه",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 149.88,
          "end": 153.34,
          "text": "خونه هم، خونهی که دارم توش زندگی میکنم",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 153.34,
          "end": 155.64,
          "text": "قبلن بهتون گفته بودم",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 155.64,
          "end": 157.8,
          "text": "مثلا این بشه په میلیارد",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 157.8,
          "end": 159.88,
          "text": "تفاوتی برای من نداره",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 159.88,
          "end": 161.54,
          "text": "من دارم تو اون خونه زندگی میکنم",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 161.54,
          "end": 163.82,
          "text": "من سروتمند نمیشم",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 165.28,
          "end": 168.52,
          "text": "دارایی باید درامدزا باشه",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 168.52,
          "end": 169.62,
          "text": "نه هزینه زا",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 169.62,
          "end": 173.94,
          "text": "یعنی در ابتدایی که من میخوام پولم رو خرج بکنم",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 173.94,
          "end": 179.94,
          "text": "گردش مالی زندگی من باید بر اساس دارایی های درامتزا باشه",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 179.94,
          "end": 185.14,
          "text": "من باید دارایی درامتزا ایجاد بکنم نه دارایی حزینزا",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 185.14,
          "end": 192.08,
          "text": "مثلا به من میگن که تو صد میلیون برنده شدی",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 192.08,
          "end": 194.22,
          "text": "چی کار میکنی؟",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 194.96,
          "end": 199.14,
          "text": "خب من میگم که صد میلیون ماشینم رو عوض میکنم",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 200.44,
          "end": 203.74,
          "text": "در جا به من خواهن گفت که تو ذهن فقیر داری",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 204.58,
          "end": 207.86,
          "text": "چرا که داری یک دارای حزینزا ایجاد میکنی",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 207.86,
          "end": 213.3,
          "text": "این ماشین جریمه میشی، تعمیر میخواد، پول بیمه باید بدی",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 213.3,
          "end": 216.82,
          "text": "پس داره حزینهی به زندگی تضافه میکنه",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 216.82,
          "end": 220.2,
          "text": "ولی اگر بگم که من با این صد ملیون",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 220.2,
          "end": 223.72,
          "text": "یه ماشین میخرم میدم به یکی بهاش کار کنه",
          "review_item_id": "segment-0048"
        },
        {
          "segment_id": 49,
          "start": 223.72,
          "end": 227.02,
          "text": "بگن آفرین، تو ذهن سروتمندی داری",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 227.02,
          "end": 235.16,
          "text": "چرا؟ چون این ماشینی که میخوایی بخری میره وارد یک کس بکار میشه و برای تو درامد ایجاد میکنه",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 235.16,
          "end": 245.88,
          "text": "پس در ابتدایی که ما میخواییم تصمیم بگیریم به خرید یک کالایی باید ببینیم این دارایی درامدزای یا حزینزا",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 245.88,
          "end": 251.26,
          "text": "اگر دارایی درامدزای میخرییم یعنی ما اندیشه سروتمندی داریم",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 251.26,
          "end": 256.84,
          "text": "داریم پولمون رو وارد دارایی هایی میکنیم که برای ما درامد ایجاد میکنه",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 256.84,
          "end": 262.22,
          "text": "ولی اگر ما بریم و دارایی حزینزا بخریم",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 262.22,
          "end": 264.72,
          "text": "مثلا تو بازاری های قدیم مرسوم بود",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 264.72,
          "end": 268.92,
          "text": "می گفتن که خونه، از خونه خونه در نمیاد",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 268.92,
          "end": 270.68,
          "text": "برابر این خونه نمی خریدن",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 270.68,
          "end": 273.12,
          "text": "می گفتن از مغازه خونه در میاد",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 273.92,
          "end": 276.74,
          "text": "از مغازه ممکنه چند تا خونه در بیاد",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 276.74,
          "end": 279.18,
          "text": "چرا؟ چون مغازه دارایی درامتزاه",
          "review_item_id": "segment-0060"
        }
      ]
    },
    {
      "id": 2,
      "start": 279.18,
      "end": 535.44,
      "segments": [
        {
          "segment_id": 61,
          "start": 279.18,
          "end": 282.42,
          "text": "ولی خونهی که توش نشستیم درامتزا نیست",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 282.42,
          "end": 286.48,
          "text": "ما باید در ابتدایی که می خواییم خرج بکنیم",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 286.48,
          "end": 292.1,
          "text": "همه درامد من رو بریم دارای های درامدزا بخریم، نه دارای های حزینزا",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 293.86,
          "end": 299.5,
          "text": "خب، پس زندگیمون رو چجوری بگذارونیم؟ آفرین، شاخص دوم",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 299.5,
          "end": 305.58,
          "text": "پس تو تصمیم گیریه که داریم یک شاخص دارای درامدزا، دارای حزینزا",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 305.58,
          "end": 307.98,
          "text": "اول باید دارای های درامدزا بخریم",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 307.98,
          "end": 313.32,
          "text": "دو، اگر من همه رو دارای درامدزا بخرم، زندگیم رو چجوری بگذارونم؟",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 313.32,
          "end": 316.4,
          "text": "شاخص دوم، نیاز یا خواسته",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 318.16,
          "end": 326.74,
          "text": "باید از محل درامد من ابتدا نیاز هامون رو پاسخ بدیم اما خواسته هامون رو نگه داریم",
          "review_item_id": "segment-0069"
        },
        {
          "segment_id": 70,
          "start": 326.74,
          "end": 328.12,
          "text": "دست نگه داریم",
          "review_item_id": "segment-0070"
        },
        {
          "segment_id": 71,
          "start": 328.12,
          "end": 330.72,
          "text": "بریم دارای درامدزا بخریم",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 330.72,
          "end": 336.9,
          "text": "از محل دارای های درامدزا به خواسته هامون پاسخ بدیم",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 336.9,
          "end": 342.48,
          "text": "یعنی یک گردش مالی یک حلقه اضافی ایجاد بکنیم",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 342.48,
          "end": 348.34,
          "text": "در اسطلاح میگن که مثلا آدم ها جیب درامت و حزینه شون یکیه",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 348.34,
          "end": 353.54,
          "text": "همون جیبی که درامت واردش میشه از همون جیب هم حزینه میکنن",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 353.54,
          "end": 356.44,
          "text": "بعضی ها اینجوری نیستن، یه حلقه ایجاد میکنن",
          "review_item_id": "segment-0076"
        },
        {
          "segment_id": 77,
          "start": 356.44,
          "end": 363.3,
          "text": "از جیبی که درامت کست میکنن میرن به جیبی که دارای درامت زاهه",
          "review_item_id": "segment-0077"
        },
        {
          "segment_id": 78,
          "start": 363.3,
          "end": 367.58,
          "text": "و از درامت اون دارایی حزینه میکنن",
          "review_item_id": "segment-0078"
        },
        {
          "segment_id": 79,
          "start": 367.58,
          "end": 370.52,
          "text": "یعنی دو جیبن، دو حلقه دارن",
          "review_item_id": "segment-0079"
        },
        {
          "segment_id": 80,
          "start": 370.52,
          "end": 372.76,
          "text": "باید یا حتی سه حلقه دارن",
          "review_item_id": "segment-0080"
        },
        {
          "segment_id": 81,
          "start": 372.76,
          "end": 377.28,
          "text": "یعنی از محل درامدشون دارایی درامد ذای ایجاد میکنن",
          "review_item_id": "segment-0081"
        },
        {
          "segment_id": 82,
          "start": 377.28,
          "end": 383.06,
          "text": "از محل درامد اون دارایی باز یه دارایی دیگه ایجاد میکنن",
          "review_item_id": "segment-0082"
        },
        {
          "segment_id": 83,
          "start": 383.06,
          "end": 388.52,
          "text": "و بعد از محل درامد اون دارایی تازه حزینه زندگیشون رو پرداخت میکنن",
          "review_item_id": "segment-0083"
        },
        {
          "segment_id": 84,
          "start": 388.52,
          "end": 394.1,
          "text": "میگن سرفتمنان کلن 5 درصد دارایهاشون تو زندگیشونه",
          "review_item_id": "segment-0084"
        },
        {
          "segment_id": 85,
          "start": 394.1,
          "end": 396.72,
          "text": "95 درصدشون تو این حلقه هاست",
          "review_item_id": "segment-0085"
        },
        {
          "segment_id": 86,
          "start": 396.72,
          "end": 400.6,
          "text": "ما این حلقه ها رو قبلنم صحبت کردیم راجبش",
          "review_item_id": "segment-0086"
