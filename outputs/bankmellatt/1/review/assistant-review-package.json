{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 255.54,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 5.8,
          "text": "وقتی تا به سنا می رفتیم باقی پدر بزرگم، اون به ما یه داست می داد که مثلاً علف های هرز رو بچینیم",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 5.8,
          "end": 11.92,
          "text": "یا اینکه یه سسلی می داد بریم گلاس بچینیم یا بیل دستمون می داد که زمین رو یکمی شخم بزنیم",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 11.92,
          "end": 16.66,
          "text": "و ما نمی تونستیم به همون می گفتش که پس تو مدرسه به شما چی یاد می دن؟",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 17.28,
          "end": 20.4,
          "text": "ما می موندیم که جواب این سواله چجوری باقید؟",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 28.98,
          "end": 35.94,
          "text": "سلام، وقتی ما به شخصیت یک انسان نگاه میکنیم و میخواییم اون رو بررسی بکنیم",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 35.94,
          "end": 40.5,
          "text": "میتونیم از چهار ظاویه مورد بررسی قرار بدیم",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 40.5,
          "end": 44.16,
          "text": "ظاویه اول، بود معناست",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 44.16,
          "end": 49.82,
          "text": "یعنی فرض کنید که یک مربعی داریم، این مربع شخصیت یک انسان",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 51.16,
          "end": 57.74,
          "text": "توی سطح بالا، بود معنا اینه که آیا من واقعاً",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 57.74,
          "end": 76.84,
          "text": "اونچنان که باید باشم هستم؟ آیا زندگی برای من معنا داره؟ آیا اون کارهایی که باید انجام بدم و انجام میدم؟ آیا اون کارهایی که میتونم انجام بدم و انجام میدم؟ آیا این کارها کارهای درستیه؟ آیا کارهای درست و به درستی انجام میدم؟",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 76.84,
          "end": 85.14,
          "text": "اینها جزو مهمترین سؤالات بشره. انسان همواره با این بود معنای زندگی مواجهه.",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 85.14,
          "end": 89.5,
          "text": "وقتی یه نفر پاسخهای درستی برای این بود فراهم بکنه",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 89.5,
          "end": 93.06,
          "text": "یک بود از شخصیتش رو ارتقا داده",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 93.06,
          "end": 98.3,
          "text": "بود دیگه شخصیت انسان بود علمی شه",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 98.3,
          "end": 103.7,
          "text": "یعنی آگاهی از اون معنای زندگی، آگاهی از اون درستی کار",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 103.7,
          "end": 107.2,
          "text": "آگاهی از آن درست انجام دادن کارها",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 107.2,
          "end": 109.9,
          "text": "تو مدیریتم یه اسطلاحی هست",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 109.9,
          "end": 114.54,
          "text": "مثلا میگن که وقتی ما کار درست رو انجام میدیم اثر بخشیم",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 114.54,
          "end": 118.28,
          "text": "وقتی اون کار رو به درستی انجام بیدیم کار آمدیم",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 118.28,
          "end": 120.58,
          "text": "کار آمدی و اثر بخشی یعنی بهروری",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 120.58,
          "end": 124.4,
          "text": "یه شخصیت بهرور تو هر دو بعد کار درست",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 124.4,
          "end": 129.82,
          "text": "و درستی انجام کار موفقه و داناست و میدونه چی کار بکنه",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 129.82,
          "end": 134.38,
          "text": "این بعد علمی چهار نوع تفکر لازم داره",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 134.38,
          "end": 140.94,
          "text": "تفکر خلاق، تفکر سیستمی، تفکر راه بردی و تفکر انتقادی",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 140.94,
          "end": 149.82,
          "text": "این شیوه اندیشیدن کمک میکنه دانشهای درستی و برای اون معنای زندگیش، برای اون معمولیت زندگیش",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 149.82,
          "end": 155.3,
          "text": "یا بهتر بگیم، برای اون موسیقی زندگیش، برای اون تم زندگیش پیدا بکنه",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 155.3,
          "end": 159.46,
          "text": "خب، لزومن ما آنچه که میدانیم عمل نمی کنیم",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 159.46,
          "end": 164.34,
          "text": "یعنی معمولا خیلی چیزها رو میدونیم و عمل نمی کنیم، خیلی طبیعی هم هست",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 165.6,
          "end": 169.78,
          "text": "چرا؟ پس چرا آدم ها در معرض آموزش قرار میگیرن؟",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 169.78,
          "end": 175.46,
          "text": "آموزش پیش ورزش اینه که وقتی من دانایی بدم پس طرف محارت هم پیدا میکنه",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 175.46,
          "end": 181.98,
          "text": "اما اینگونه نیست میبینیم آموزش میدیم ولی هیچ تغییر در رفتار صورت نمیگره",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 181.98,
          "end": 187.4,
          "text": "یا خیلی چیزها رو خودمون میدونیم و انجام نمیدیم مثلا میدونیم ورزش کردن خوبه ورزش نمیکنیم",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 187.4,
          "end": 191.9,
          "text": "یا سیگار کشیدم بده اما سیگار میکشیم ولی من سیگار نمیکشم",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 191.9,
          "end": 198.92,
          "text": "خب چه چیزی باعث میشه دانش ما به یک رفتار تبدیل بشه",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 198.92,
          "end": 202.26,
          "text": "یا چه چیزی باعث میشه دانش ما به رفتار تبدیل نشه",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 202.26,
          "end": 204.72,
          "text": "اون بود احساسی ماست",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 204.72,
          "end": 209.88,
          "text": "یعنی ما وقتی نسبت به داناییمون احساسی نداریم",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 209.88,
          "end": 212.18,
          "text": "بنابراین تبدیل به رفتار نمیشه",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 212.18,
          "end": 216.06,
          "text": "اصلا رفتار مبتنی بر دانایی شکل نمیگیره",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 216.06,
          "end": 219.3,
          "text": "رفتار مبتنی بر یک باور شکل میگیره",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 219.3,
          "end": 222.7,
          "text": "باور یعنی علم به علاوه احساس",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 222.7,
          "end": 226.54,
          "text": "وقتی علممون با احساسمون عقد میبنده",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 226.54,
          "end": 230.92,
          "text": "یک عقیده شکل میگیره و عقیده باعث میشه آدم ها رفتار بکنن",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 230.92,
          "end": 233.46,
          "text": "پس بود احساسی خیلی مهمه",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 233.46,
          "end": 238.52,
          "text": "اون چه که توی عدبیات جدید بهش میگن حوش آتفی",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 238.52,
          "end": 246.96,
          "text": "یعنی توانای شناخت و مدیریت احساسات خود و دیگران",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 246.96,
          "end": 251.88,
          "text": "ما باید بتونیم احساسات خودمون رو کنترول بکنیم",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 251.88,
          "end": 255.54,
          "text": "اونها رو بشناسیم اول و بعد بتونیم کنترولش بکنیم",
          "review_item_id": "segment-0048"
        }
      ]
    },
    {
      "id": 2,
      "start": 255.54,
      "end": 492.32,
      "segments": [
        {
          "segment_id": 49,
          "start": 255.54,
          "end": 259.32,
          "text": "احساساتی مثل خشم، دوست داشتن، ترس، شجاعت",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 259.32,
          "end": 266.64,
          "text": "تمه، همه این انواع احساس باعث میشه که ما نسبت به علممون",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 266.64,
          "end": 272.42,
          "text": "یک ویژگی در ما شکل بگیره که اون رو تبدیل به یک رفتار بکنه",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 272.42,
          "end": 282.1,
          "text": "پس بود ثوم شخصیت ما هم بود احساسی ماست، بود معنا، بود علم، بود احساس",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 282.1,
          "end": 289.5,
          "text": "خب این سه بود باعث میشه که ما یک شخصیت کامل داشته باشیم، نه",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 289.5,
          "end": 294.2,
          "text": "یکی از مهمترین عباد شخصیت ما بود مادیه",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 294.2,
          "end": 299.08,
          "text": "یعنی همین کسی که هستیم، همین چیزی که در آلم فیزیک وجود داره",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 299.08,
          "end": 304.14,
          "text": "همین چیزی که اون عباد دیگه خیلی ملموس نبود",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 304.14,
          "end": 308.4,
          "text": "مثلا بود علمی، دانایی و آگاهی کجاست، احساسات ما کجاست",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 308.4,
          "end": 313.1,
          "text": "همه اونها در یک وجود فیزیکی تجلی پیدا میکنه",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 313.1,
          "end": 316.32,
          "text": "مثلا ما میترسیم ممکنه ضربان قلبمون بالا بره",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 316.32,
          "end": 322.46,
          "text": "یا وقتی علم و آگاهی پیدا میکنیم دوچار شادابی و شعف میشیم",
          "review_item_id": "segment-0060"
        },
        {
          "segment_id": 61,
          "start": 322.46,
          "end": 325.24,
          "text": "یا وقتی معنای زندگیمون رو پیدا میکنیم",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 325.24,
          "end": 328.8,
          "text": "انرژیمون برای انجام کارها بالا میره",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 328.8,
          "end": 332.8,
          "text": "آدم سرحالی هستیم، مثلا تصور بکنیم، می توانید این کار رو الانجام بدیم",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 332.8,
          "end": 336.86,
          "text": "مثلا خمیده بشین، گردنتون رو کش بکنی، شونهاتون رو بندازیم",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 336.86,
          "end": 345.38,
          "text": "این یه احساس به ما می دهید، یعنی این آلم فیزیک در آلم متافیزیک یا اون ماورای ما اثر می داره",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 345.38,
          "end": 350.88,
          "text": "سطح انرژی ما رو تعییم می کنه، حتی اگر علکی و خیلی شکلی این کار رو انجام بودیم",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 350.88,
          "end": 360.54,
          "text": "وقتی راست بشینیم شونمه هامون رو بالا ببریم، گردنمون رو بر افراشده نگه داریم، ببینیم فتح انرژیمون کاملا تغییر کرد",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 360.54,
          "end": 366.34,
          "text": "خب این بعد مادی، اصلا ما تو این دنیا هستیم که تو این بعد مادی رو تجربه بکنیم",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 366.34,
          "end": 373.58,
          "text": "مهمترین بعد شخصیت ماست و نادیده گرفتن، اون نادیده گرفتن یکی از مهمترین عباده",
          "review_item_id": "segment-0069"
        },
        {
          "segment_id": 70,
          "start": 373.58,
          "end": 378.38,
          "text": "چون این بود به سایر عباد دیگه ما خدمت رسانی میکنه",
          "review_item_id": "segment-0070"
        },
        {
          "segment_id": 71,
          "start": 378.38,
          "end": 385.04,
          "text": "یعنی خدمت گذار بود احساسی ما، بود علمی ما و بود معنای ما",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 385.04,
          "end": 392.3,
          "text": "در واقع ما از طریق انجام اعمال فیزیکی خودمون رو در دنیا متجلی میکنیم",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 392.92,
          "end": 398.22,
          "text": "توی بود معنا میگیم که خب من چه چیز عرضشمندی باید تو دنیا خلق بکنم",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 398.22,
          "end": 401.76,
          "text": "چه چیزی از طریق من باید در دنیا متجلی بشه",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 401.76,
          "end": 404.84,
          "text": "خب با رفتارهایی که تو همین آلم فیزیک میکنیم",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 404.84,
          "end": 408.76,
          "text": "با همین کارهایی که به صورت مادی انجام میدیم اون متجلی میشه",
          "review_item_id": "segment-0076"
        },
        {
          "segment_id": 77,
          "start": 409.38,
          "end": 411.96,
          "text": "علم آموزی ما باید حرکت بکنیم",
          "review_item_id": "segment-0077"
        },
        {
          "segment_id": 78,
          "start": 411.96,
          "end": 414.02,
          "text": "بریم یه جا سریع کلاسی بشینیم",
          "review_item_id": "segment-0078"
        },
        {
          "segment_id": 79,
          "start": 414.02,
          "end": 416.18,
