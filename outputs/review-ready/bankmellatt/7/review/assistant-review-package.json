        },
        {
          "segment_id": 189,
          "start": 834.01,
          "end": 837.49,
          "text": "من یک کالایی رو نیاز دارم میذارم زمان هراجی میخرم",
          "review_item_id": "segment-0189"
        },
        {
          "segment_id": 190,
          "start": 837.49,
          "end": 839.77,
          "text": "میذارم زمانی که تخصیف خورد میخرم",
