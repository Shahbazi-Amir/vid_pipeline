        },
        {
          "segment_id": 212,
          "start": 930.53,
          "end": 934.95,
          "text": "خودمو در معرض خرش کردنهای بی مورد قرار نمیدن",
          "review_item_id": "segment-0212"
        },
        {
          "segment_id": 213,
          "start": 934.95,
          "end": 939.21,
          "text": "این هیچ ریاضت مالی نیف، هیچ خصاصتی نیف",
          "review_item_id": "segment-0213"
        },
        {
          "segment_id": 214,
          "start": 939.21,
          "end": 942.81,
          "text": "بلکه تمرینه، دونید آدم میره باشگاه",
