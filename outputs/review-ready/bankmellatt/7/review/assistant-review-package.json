{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 250.37,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 13.28,
          "text": "اول سال نو یا روز تولدمون یا اون شنبه‌ای که هیچوقت نمیاد، تصمیم می‌گیریم که خیلی از کارها رو نکنیم و خیالی برنامه‌ها را اجرا بکنم و به اهدافمون برسیم.",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 13.28,
          "end": 18.52,
          "text": "اما بعد از چند وقت یا آخر همون روز کارهایی کردیم که نمیخواستیم",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 18.52,
          "end": 22.16,
          "text": "کارهاییو که باید انجام میدادیم و انجام ندادیم",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 22.16,
          "end": 23.32,
          "text": "چرا؟",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 23.32,
          "end": 27.02,
          "text": "چون اون چی که میدونیم معمولاً به ما آسیب نمیزنه",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 27.02,
          "end": 30.48,
          "text": "بلکه اون چی که نمیدونیم به ما آسیب نمیزنه",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 40.67,
          "end": 44.49,
          "text": "سلام، خوشحالم که باز هم خدمت شما هستم",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 44.49,
          "end": 48.97,
          "text": "و میتونیم در باره آموزه های سواد مالی با هم دیگه صحبت کنیم",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 49.87,
          "end": 56.59,
          "text": "گفتیم که ما خوبه که بخشی از درامد من رو کنار بذاریم به محض دریافت",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 56.59,
          "end": 62.47,
          "text": "و در قالب پسنداز، صندوق استراری و یاری دیگران از اونها",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 62.47,
          "end": 88.35,
          "text": "نگهداری بکنیم. نگهداریمونم این نبود که بذاریم یه گوشه ای و دست بهش نزنیم. بلکه نگهداری از اون به معنای این بود که به کارش بندازیم و عرضشش رو حفظ بکنیم، جریان درامدی ایجاد بکنیم و حتی رشدش بدیم. خب گفتیم حتما این پول پسنداز و صندوق استرائی باید خارج از حزینه های زندگیمون باشه.",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 88.35,
          "end": 95.57,
          "text": "یه سؤال مهم اینه که حزینه های زندگی من اونقدر هست که نمیرسم اصلا به پسنده هست",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 95.57,
          "end": 101.95,
          "text": "یعنی اگر یه بخشی از پولم هم کم بکنم باعث میشه که اصلا به زندگی روزانم نرسه",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 102.83,
          "end": 108.61,
          "text": "اولین جواب اینه که خب پس معلومه که یه کمی از درامد آینده تون خوردید",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 109.55,
          "end": 111.97,
          "text": "امروز آینده ی دیروزتونه",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 111.97,
          "end": 116.71,
          "text": "فکر میکنم که دیروز یه حزینه هایی کردید و یه قرض هایی ایجاد کردید",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 116.71,
          "end": 122.47,
          "text": "که الان قصد اونها، پرداخت اونها باعث میشه که یه فشاری به زندگیتون بیاد",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 122.47,
          "end": 128.56,
          "text": "و اجازه نده که پسنداز مناسب یا صندوق استراری داشته باشید",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 129.29,
          "end": 136.35,
          "text": "دوم این که معمولا ما آدم ها یک درصدی پرت زندگی مالی داریم",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 136.35,
          "end": 140.39,
          "text": "یعنی اصلا این هیچ اثری تو زندگی مالی ما نداره",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 140.39,
          "end": 146.91,
          "text": "ولی داره خرج میشه، در واقع هدر میره، پرت میشه در اسطلاح",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 146.91,
          "end": 153.33,
          "text": "یعنی این که مثلا ده درصد از درامدمون فرض کنید که اضافه کنن",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 153.33,
          "end": 156.87,
          "text": "مثلا من چه بدونم چار ملیون حقوق میگیرم",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 156.87,
          "end": 159.99,
          "text": "درامدم بشه چار ملیون و چار سد",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 159.99,
          "end": 163.63,
          "text": "واقعا چقدر تو زندگی محصر داره؟",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 163.63,
          "end": 168.19,
          "text": "مثلا چار سد ازار تومن به حقوق چار ملیون من اضافه کنن",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 168.19,
          "end": 173.81,
          "text": "من خلافه می کنم خیلی اثر خیلی جدی تو زندگیم نشته باشه",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 173.81,
          "end": 178.17,
          "text": "بگم اوه مثلا درامد هم اضافه شد حالا چه زندگی خوبی خواهم داشم",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 178.17,
          "end": 180.81,
          "text": "ده درصد خیلی اثر نداره",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 180.81,
          "end": 185.67,
          "text": "پس نشون می ده ده درصد از درامد من کم بشه خیلی اثر نداره",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 185.67,
          "end": 188.39,
          "text": "یعنی حقوق من بشه سه و شیش ست",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 188.39,
          "end": 192.67,
          "text": "خیلی من با تلاتومی توی زندگی مواجه نمی شم",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 193.67,
          "end": 199.21,
          "text": "این نشون میده ده درصد از زندگی مالی من داره به هدر میره",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 199.21,
          "end": 203.81,
          "text": "که نه افضایش اثری تو زندگیم داره، نه کاهشش",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 203.81,
          "end": 207.75,
          "text": "ما باید این ده درصد ها رو پیدا بکنیم",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 207.75,
          "end": 212.37,
          "text": "این ده درصد ها کمک میکنه که ما بتونیم پسنداز بهتری داشته باشیم",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 212.37,
          "end": 216.55,
          "text": "خب اگر حقوق من سه و شیش ست باشه، مثلا بشه چار ملیون",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 216.55,
          "end": 219.49,
          "text": "خب من میتونم چارسد هزارتون رو پسنداز بکنم",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 219.49,
          "end": 222.91,
          "text": "بدون این که اثر خاصی تو سبک زندگی میداشته باشه",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 222.91,
          "end": 225.67,
          "text": "یا اگه چار ملیون هم بشه چار و چارسد",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 225.67,
          "end": 228.33,
          "text": "خب ده درصد میتونم خوب پسنداز بکنم",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 228.33,
          "end": 232.65,
          "text": "بدون این که مثلا بخوام خرچ های بیرویه بکنم",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 232.65,
          "end": 235.29,
          "text": "یا نه خصاصت های خاصی به خرچ بدم",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 236.21,
          "end": 239.23,
          "text": "پس این ده درصد ها، پونزه درصد ها",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 239.23,
          "end": 241.35,
          "text": "ممکنه حد در رفت زندگیمون باشه",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 241.35,
          "end": 243.39,
          "text": "ما باید اینها رو پیدا بکنیم",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 244.17,
          "end": 247.81,
          "text": "ببینید ما وقتی خرج میکنیم، هزینه میکنیم",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 247.81,
          "end": 250.37,
          "text": "تحت یک فرایند این کار رو انجام میدیم",
          "review_item_id": "segment-0048"
        }
      ]
    },
    {
      "id": 2,
      "start": 250.37,
      "end": 483.81,
      "segments": [
        {
          "segment_id": 49,
          "start": 250.37,
          "end": 252.63,
          "text": "بهش میگم فرایند خرید کردن",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 252.63,
          "end": 255.57,
          "text": "چه خرید خدمات باشه، چه خرید کاله ها",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 255.57,
          "end": 259.63,
          "text": "مثلا من اینترنت خرید میکنم، نمیدونم",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 259.63,
          "end": 262.91,
          "text": "شارج اینترنت منظورمه، خرید میکنم",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 262.91,
          "end": 265.69,
          "text": "یا میرم خریدهای اینترنتی دارم",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 265.69,
          "end": 268.13,
          "text": "این هم توی فروشگاه در واقع مجازی",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 268.13,
          "end": 270.63,
          "text": "اونجا خیلی جنس ها رو میبینم خرید میکنم",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 270.63,
          "end": 276.33,
          "text": "تیه ایک فرایندی یا میرم مدرسه پسرم رو ثبت نام میکنم",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 276.33,
          "end": 281.23,
          "text": "توی مدرسه غیر انتفاعی و اونجا خرید خدمت میکنم",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 281.23,
          "end": 282.91,
          "text": "خدمات آموزشی میخرم",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 282.91,
          "end": 289.27,
          "text": "پس این فراینده خریده ایک فرایندی که ما بهاش پولامون رو خرج میکنیم",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 289.95,
          "end": 292.95,
          "text": "اون حدر رفته رو باید اینجاها پیدا بکنیم",
          "review_item_id": "segment-0060"
        },
        {
          "segment_id": 61,
          "start": 292.95,
          "end": 295.91,
          "text": "من خرج چه چیزهایی میکنم؟",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 295.91,
          "end": 302.71,
          "text": "چه الگوهایی در خرید کردن من وجود داره که باعث میشه زندگیم حدر رفت داشته باشه؟",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 302.97,
          "end": 305.55,
          "text": "من چند تا الگو رو براتون مثال میزنم",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 305.55,
          "end": 309.17,
          "text": "یکی از الگوها من اسمش رو گذاشتم مردانه",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 309.17,
          "end": 311.77,
          "text": "ولی لزومنم یون مردا وجود ندارم",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 311.77,
          "end": 314.93,
          "text": "ممکنه بعضی از خانوم هام اینجوری خرید بکنن",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 314.93,
          "end": 318.25,
          "text": "ولی عموما خریدهای مردانه این شکلیه",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 318.25,
          "end": 322.99,
          "text": "که برای اثبات قدرت و تسلط آدم هاست",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 322.99,
          "end": 326.31,
          "text": "یعنی اصلا نیاز یا هدف خاصی ندارن",
          "review_item_id": "segment-0069"
        },
        {
          "segment_id": 70,
          "start": 326.31,
          "end": 331.51,
          "text": "ولی برای اینکه ثابت بکنن ما مرد خونهی میرن این حضینا رو انجام میدن",
          "review_item_id": "segment-0070"
        },
        {
          "segment_id": 71,
          "start": 332.67,
          "end": 339.67,
          "text": "مثلا خانم من به من پیام میده که دو تا سیبزمینی و سه چار تا دونه پیاز بگیر",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 339.67,
          "end": 344.47,
          "text": "خب، حالا نوبت منه که مردانگی خودم رو اثبات بکنم",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 345.27,
          "end": 351.15,
          "text": "میرم بازار تر بار دو تا گونی سیبزمینی و سه چار تا گونی پیاز میگیرم",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 351.15,
          "end": 357.85,
          "text": "میام خونه و همچین با یه اقتداری میگم بفهمه خانوم این هم اون سیبزمینی و پیازی که میخواستی",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 357.85,
          "end": 364.27,
          "text": "یعنی من در یک حجم وسیع خرید میکنم که برای نشون بدم که با دستمون تو جیب خودمونه",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 364.27,
          "end": 368.99,
          "text": "ما مرد خونه ایم نشون بدیم که ما مسلطیم، توامندیم",
          "review_item_id": "segment-0076"
        },
        {
          "segment_id": 77,
          "start": 369.75,
          "end": 375.67,
          "text": "خانوم هم میگه بابا اصلا احتیاجی نبود انقدر سیبزمینی نمیخواییم انقدر پیاز نمیخواییم",
          "review_item_id": "segment-0077"
        },
        {
          "segment_id": 78,
          "start": 375.67,
          "end": 377.77,
          "text": "ما دوتا سیبزمینی میخواستیم و ستا پیاز",
          "review_item_id": "segment-0078"
        },
        {
          "segment_id": 79,
          "start": 377.77,
          "end": 385.01,
          "text": "این خریده تو این حجم وسیع برای اثبات خودم، برای اثبات قدرت خودم و بهش میگیم ملگوی مردانه",
          "review_item_id": "segment-0079"
        },
        {
          "segment_id": 80,
          "start": 386.73,
          "end": 390.29,
          "text": "لزومی نداره، اصلا موضوع مالی نیست، موضوع آتفیه",
          "review_item_id": "segment-0080"
        },
        {
          "segment_id": 81,
          "start": 390.29,
          "end": 392.87,
