        },
        {
          "segment_id": 173,
          "start": 831.68,
          "end": 837.58,
          "text": "یعنی میگه من در هر موقعیت و شرایطی که برام پیش بیاد",
          "review_item_id": "segment-0173"
        },
        {
          "segment_id": 174,
          "start": 837.58,
          "end": 841.32,
          "text": "یا خودم اون موقعیت و شرایط رو پیشبینی بکنم",
