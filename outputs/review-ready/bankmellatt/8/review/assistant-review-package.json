          "end": 745.95,
          "text": "وقتی ما پول رو اختصاص میدیم به یک کالا",
          "review_item_id": "segment-0174"
        },
        {
          "segment_id": 175,
          "start": 745.95,
          "end": 749.63,
          "text": "در واقع داریم از یک کالای دیگه دست بر میداریم",
          "review_item_id": "segment-0175"
        },
        {
          "segment_id": 176,
          "start": 749.63,
          "end": 753.21,
          "text": "اون کالایی که ازش دست بر میدونیم و بهش میگیم هزینه فرصت",
          "review_item_id": "segment-0176"
        },
        {
          "segment_id": 177,
          "start": 753.21,
          "end": 757.51,
          "text": "بینید من یک بعد از ظهر توی روز دوشنبه وقت دارم",
          "review_item_id": "segment-0177"
        },
        {
          "segment_id": 178,
          "start": 757.51,
          "end": 760.29,
          "text": "مثلا دوشنبه دهم خورداد",
          "review_item_id": "segment-0178"
        },
        {
          "segment_id": 179,
          "start": 760.29,
          "end": 768.67,
          "text": "یک روز منه و بعد از ظهرش دهم خورداد 1400 هیچ وقتی یک تو زندگی من تکرار نمیشه",
          "review_item_id": "segment-0179"
        },
        {
          "segment_id": 180,
          "start": 769.45,
          "end": 773.85,
          "text": "من این بعد از ظهر رو میتونم برم فوتبال، میتونم برم سینما",
          "review_item_id": "segment-0180"
        },
        {
          "segment_id": 181,
          "start": 773.85,
          "end": 778.07,
          "text": "خب وقتی تصمیم میرم سینما یعنی چی؟",
          "review_item_id": "segment-0181"
        },
        {
          "segment_id": 182,
          "start": 778.07,
          "end": 780.59,
          "text": "یعنی از فوتبال دست برداشتم",
          "review_item_id": "segment-0182"
        },
        {
          "segment_id": 183,
          "start": 780.59,
          "end": 785.23,
          "text": "حضینه ی فرصت سینما رفتن، فوتبال از دست دادنه",
          "review_item_id": "segment-0183"
        }
      ]
    },
    {
      "id": 4,
      "start": 785.23,
      "end": 989.47,
      "segments": [
        {
          "segment_id": 184,
          "start": 785.23,
          "end": 791.63,
          "text": "پس صرفاً این نیست که من پول بیلیت سینما رو دارم برم سینما",
