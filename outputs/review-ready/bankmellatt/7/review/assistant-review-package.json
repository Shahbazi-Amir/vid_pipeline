        },
        {
          "segment_id": 172,
          "start": 731.71,
          "end": 738.17,
          "text": "پنجومین، الگوی نامناسب خرید کردن، الگوی بازاریابان است",
          "review_item_id": "segment-0172"
        },
        {
          "segment_id": 173,
          "start": 738.17,
          "end": 747.17,
          "text": "ببینید بازاریاب ها یک سری فعالیت های از قبیله، حراج، کپونه، تخصیف، نمیدونم جمعه سیاه، یک شنبه سیاه",
          "review_item_id": "segment-0173"
        },
        {
          "segment_id": 174,
          "start": 747.83,
          "end": 750.93,
          "text": "همه این کارها رو میکنن که شما خرید بکنید",
