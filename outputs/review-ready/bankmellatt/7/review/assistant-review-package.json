        },
        {
          "segment_id": 175,
          "start": 750.93,
          "end": 757.71,
          "text": "طبعیت از این الگوها باعث میشه که یک خریدهایی بکنید که حدر رفت زندگیتونه",
          "review_item_id": "segment-0175"
        },
        {
          "segment_id": 176,
          "start": 757.71,
          "end": 760.55,
          "text": "به کیفیت زندگی چیزی اضافه نمیکنه",
