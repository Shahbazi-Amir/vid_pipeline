        },
        {
          "segment_id": 219,
          "start": 929.93,
          "end": 937.65,
          "text": "پس این هزینه فرصت هم یه شاخص تصمیم گیری درست برای سب که خرش کردنهای ماست",
          "review_item_id": "segment-0219"
        },
        {
          "segment_id": 220,
          "start": 937.65,
          "end": 941.51,
          "text": "این ستا شاخص کمک میکنه، اراته شاخصهای دیگه هم وجود داره",
          "review_item_id": "segment-0220"
        },
        {
          "segment_id": 221,
          "start": 941.51,
          "end": 947.97,
          "text": "اما ما همین ستا رو به کار بگیریم کمک میکنه که حدر رفت کمتری تو زندگیمون داشته باشیم",
          "review_item_id": "segment-0221"
        },
        {
          "segment_id": 222,
          "start": 947.97,
          "end": 952.43,
          "text": "و بتونیم امنیت و آزادی مالی بهتری رو بر خودمون فراهم کنه",
          "review_item_id": "segment-0222"
        },
        {
          "segment_id": 223,
          "start": 952.43,
          "end": 958.69,
          "text": "تفاوت یک انسان فقیر و یک انسان سروتمند در میزان پولشون نیست",
          "review_item_id": "segment-0223"
        },
        {
          "segment_id": 224,
          "start": 958.69,
          "end": 961.49,
          "text": "در محارت سروت آفرینیشونه",
