{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 265.85,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 11.16,
          "text": "ضروری ترین و ابتدایی ترین گام برای توسعی اون مربع شخصیتتون بود مالی تونه",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 11.16,
          "end": 16.1,
          "text": "چون این داره به سایر عباد خدمت میرسونه",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 28.61,
          "end": 31.73,
          "text": "آدم فقیر لزومن آدم خوبی نیست",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 31.73,
          "end": 35.09,
          "text": "آدم سروتمند هم لزومن آدم خوبی نیست",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 35.09,
          "end": 38.85,
          "text": "مسئله اصلا آدم خوب بودن و بد بودن نیست",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 38.85,
          "end": 42.69,
          "text": "مسئله پوله، من بتونم اقدام بکنم",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 42.69,
          "end": 47.97,
          "text": "یعنی شاخص خوب بودن و بد بودن اصلا سروت نیست",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 47.97,
          "end": 51.57,
          "text": "که فقیری خوب باشه یا سروتمندی بد باشه",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 51.57,
          "end": 55.39,
          "text": "من باید تو این بعد وجودیم توامند باشم",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 55.39,
          "end": 57.13,
          "text": "یه نیازی به من وارد شد",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 57.13,
          "end": 59.99,
          "text": "بتونم بهش پاسخ بدم خیلی راحت",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 59.99,
          "end": 63.31,
          "text": "نه به هشتاد جای بدنم فشار بیاد",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 63.31,
          "end": 69.49,
          "text": "که من میخواهم یه ملیون، سه ملیون، چار ملیون خرش کنم",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 69.49,
          "end": 75.77,
          "text": "یه راهکار، یه ایده، یه چیزی بگین که ما بتونیم مدیریت مالی بکنیم از همین الان",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 75.77,
          "end": 81.39,
          "text": "باید پول تو جیبی تو، ولو این که مایی پنجا هزار تومنه یا ده هزار تومنه یا یه ملیون تومنه",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 81.39,
          "end": 84.45,
          "text": "باید باش تمرین مدیریت مالی کنیم",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 84.45,
          "end": 95.65,
          "text": "و ضروری ترین و ابتدایی ترین گام برای توسعی اون مربع شخصیتتون بود مالی تونه",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 96.45,
          "end": 100.53,
          "text": "چون این داره به سایر عباد خدمت میرسونه",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 100.53,
          "end": 107.45,
          "text": "از منظر اینکه من بنزین باید بزنم تو این را بیفته، بود مالی مهم میشه",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 107.45,
          "end": 111.83,
          "text": "سواد مالی یعنی تمرین مدیریت امور مالی",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 111.83,
          "end": 114.59,
          "text": "که ازولات مالیتون تقویت بشه",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 114.59,
          "end": 122.15,
          "text": "یه بحران، یه شک تورمی، تحریمی، نمیدونم هرچی وارد زندگیتون شد",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 123.53,
          "end": 125.33,
          "text": "روبه قبله نخوابین",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 125.33,
          "end": 129.57,
          "text": "میخوایم حالا رجب سواد مالی صحبت بکنیم، جاشو فهمیدیم",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 129.57,
          "end": 132.25,
          "text": "سواد مالی موضوع زوغی نیست",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 132.25,
          "end": 135.39,
          "text": "مثلا میگیم خب سواد مالی یعنی چی؟ یعنی پسنداز بکنیم دیگه",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 135.39,
          "end": 139.55,
          "text": "سواد مالی یعنی چی؟ یعنی سرمایی گذاری بکنیم پول در بیاریم",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 139.55,
          "end": 145.91,
          "text": "نه، سواد مالی شیشتا سرفصل اساسی داره در استاندارت های بین المللی",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 146.55,
          "end": 150.29,
          "text": "خوب، اولیش چیه؟ خرج و پسنده هست",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 150.29,
          "end": 155.31,
          "text": "من باید بدونم چگونه باید خرج بکنم",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 155.31,
          "end": 162.47,
          "text": "یعنی اولینگام در سواد مالی درامد نیست خرج کردنه",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 162.47,
          "end": 164.83,
          "text": "من باید درست خرج بکنم",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 164.83,
          "end": 167.97,
          "text": "چرا که هر چقدر درامدم زیاد بشه؟",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 167.97,
          "end": 170.25,
          "text": "هزینه ها هم هم زیاد میشه",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 170.97,
          "end": 175.07,
          "text": "خب پس ما تمرین میکنیم که خرج همون رو مدیریت بکنیم",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 175.07,
          "end": 179.19,
          "text": "خب خرج همون مدیریت بکنم، اضافه میارم که",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 179.19,
          "end": 183.21,
          "text": "اضافهش چیه؟ پسندازه",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 183.21,
          "end": 187.77,
          "text": "حالا پسنداز رو اول خرج هم باید بردارم یا آخر خرج هم؟",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 187.77,
          "end": 191.73,
          "text": "اول خرج هم، پس اولین باری که هر پولی به دست میارم",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 191.73,
          "end": 196.91,
          "text": "یه مقدارشو پسنداز میکنم و بقیهشو مدیریت میکنم تا با خواسته های حالم",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 199.05,
          "end": 226.11,
          "text": "دوامی موضوع سرفصل سواد مالی مدیریت اعتبار و بدهیه من بدهکار شدم چی کار باید بکنم؟ اگر یه چیزی خواستم پولشو نداشتم چیجوری خودم رو بدهکار بکنم؟ اصلا باید بدهکار بشم؟ یا نه؟ باید از یه مسیرهای دیگه امور مالی خودم رو تأمیم بکنم چه مسیرهای مالی دیگهی وجود داره؟ این میشه سرفصل دوام اعتبار و بدهی خوب من میخوام خرج بکنم",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 226.11,
          "end": 237.89,
          "text": "میخوام پسنداز بکنم، میخوام قرضام رو بدم، چی کار باید بکنم؟ باید کار بکنم، سرفصل ثوم، کاریابی و درامت، چه کاری باید بکنم؟",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 237.89,
          "end": 246.69,
          "text": "شما باید اول شغلتون رو انتخاب بکنید، بعد به دلیل انجام اون شغل باید یه رشته تحصیلی انتخاب بکنید",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 246.69,
          "end": 251.43,
          "text": "یعنی که همینجوری برید، خیلی از این تحصیل کرده ها میرند و بعد دیگه شغلی ندارند",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 251.43,
          "end": 255.01,
          "text": "شما از همین الان باید تمرین های شغلی داشته باشید",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 255.01,
          "end": 257.69,
          "text": "شما الان بورسیه ی پدر مادرتون هستید",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 257.69,
          "end": 260.39,
          "text": "خب برید کارهای مختلف رو امتحان کنید",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 260.39,
          "end": 265.85,
          "text": "وقتی زن و بچه داشتی که نمیتونی بری کارهای مختلف رایگان امتحان کنی",
          "review_item_id": "segment-0048"
        }
      ]
    },
    {
      "id": 2,
      "start": 265.85,
      "end": 428.26,
      "segments": [
        {
          "segment_id": 49,
          "start": 265.85,
          "end": 268.03,
          "text": "بگی نه دو سال این کار رو میکنم خوشم نه ایمد",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 268.03,
          "end": 269.51,
          "text": "دو سال دیگه بری یک کار دیگه بکنی",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 269.51,
          "end": 272.87,
          "text": "در واقعیت بفهمی چه شغلی به دردت میخوره",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 272.87,
          "end": 282.29,
          "text": "سرفصل چهارم، سرمایه گذاری. من میتونم پول هامو کاری باهاش بکنم که پول ها برند، پول بیارند.",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 282.53,
          "end": 288.79,
          "text": "دیگه لازم نباشه من یک کاری بکنم و تا پول بیاد. خود پول هام برم برا من پول بیارند.",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 289.67,
          "end": 293.03,
          "text": "کدوم پول ها را میبرم، میفرستم برا من پول بیارند؟",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 293.03,
          "end": 299.95,
          "text": "آفرین. شما باید از آنان تمرین بکنید. پس اندازی داشته باشید که بعد وارد عرصه سرمایه گذاری بکنید.",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 299.95,
          "end": 313.78,
          "text": "سرمایه یعنی چی؟ یعنی پول در معرض خطر، پولی که شما، ریسکش رو میپذیرید، در معرض خطر، میبرید توی کسب و کار",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 313.78,
          "end": 320.14,
          "text": "بنابراین سرفصل پنجم، مدیریت ریسک و بیمه، باید بلد باشی",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 320.14,
          "end": 324.82,
          "text": "که من چجوری ریسک هایی که متوجه پولم میشه رو مدیریت بکنم",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 324.82,
          "end": 335.36,
          "text": "و همه این پنشتا، خرج و پسنداز، اعتبار و بدهی، کاریابی و درامت، سرمایه گذاری، مدیریت ریسکو بیمه",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 335.36,
          "end": 341.18,
          "text": "یک تصمیمگیری مالیه، میشه سرفصل ششون تصمیمگیری مالی",
          "review_item_id": "segment-0060"
        },
        {
          "segment_id": 61,
          "start": 341.18,
          "end": 344.64,
          "text": "من چجوری تصمیمات درست مالی بگیرم؟",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 345.09,
          "end": 350.2,
          "text": "اینجوری براتون بگم که من سواد مالی و یک موضوع مالی نمیدونم",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 350.2,
          "end": 356.12,
          "text": "اصلا باعد مالی و یک باعد در واقع خاص پول نمیدونم",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 356.12,
          "end": 361.0,
          "text": "من سواد مالی و یک مجموعه از زندگی میدونم",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 361.0,
          "end": 362.26,
          "text": "یه سبک زندگی",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 362.26,
          "end": 366.76,
          "text": "یعنی به کل زندگی از نگاه مالی نگاه کردن",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 366.76,
          "end": 370.42,
          "text": "بنابراین وقتی شما وارد عرصه مالی بشید",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 370.42,
          "end": 373.64,
          "text": "نمیتونید عرصه معناتون رو تو جیبتون بذارید",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 373.64,
          "end": 375.12,
          "text": "بعد بگید این بحث پوله",
          "review_item_id": null
        },
        {
          "segment_id": 70,
          "start": 375.12,
          "end": 379.76,
          "text": "نمیتونید احساستون رو کنار بذارید بگید اینجا حرف پوله",
          "review_item_id": "segment-0070"
        },
        {
          "segment_id": 71,
          "start": 379.76,
          "end": 381.38,
          "text": "علمتون رو کنار بذارید",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 381.38,
          "end": 388.86,
          "text": "به شرطی شما انسان معفق به معنایی که در ذهن خودتون هست میشید",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 388.86,
          "end": 390.14,
          "text": "نه معنای بیرونی",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 390.14,
          "end": 394.94,
          "text": "انسان معفق یکی تصویری که شما از خودتون در آینده دارید",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 394.94,
          "end": 399.56,
          "text": "به شرطی اون محقق میشه که خودتون رو رشد بدید",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 399.56,
          "end": 401.44,
          "text": "همون حرفی که اول دادید",
          "review_item_id": "segment-0076"
        },
        {
          "segment_id": 77,
          "start": 401.44,
          "end": 405.16,
          "text": "و معنای رشد یعنی توصیه این مربعه",
          "review_item_id": "segment-0077"
        },
        {
          "segment_id": 78,
          "start": 405.16,
          "end": 409.2,
          "text": "یعنی کار بکنید این مربعه بزرگ و بزرگتر بشه",
          "review_item_id": "segment-0078"
        },
        {
          "segment_id": 79,
          "start": 409.2,
          "end": 428.26,
          "text": "ما تکلیف داریم که خودمون رو توصیح بدیم. در همه عباد و به شکل کامل. تو بتونیم یک انسان کامل باشیم. و در روزی که من خودی که باید باشیم، مقابل خودی که هستیم قرار میگیره، مدیون خودمون نباشید.",
          "review_item_id": "segment-0079"
        }
      ]
    }
  ]
}
