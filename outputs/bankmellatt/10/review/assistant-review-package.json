          "text": "یعنی شما اونقدر توامند مالی باشید که به دیگران قرض بدهید",
          "review_item_id": "segment-0156"
        },
        {
          "segment_id": 157,
          "start": 794.19,
          "end": 796.69,
          "text": "نه این که قرض گرفتن خوب است",
          "review_item_id": "segment-0157"
        },
        {
          "segment_id": 158,
          "start": 796.69,
          "end": 800.07,
          "text": "انشاءالله یه روزی برسه که هیچ کس قرض گیرنده نباشه",
          "review_item_id": "segment-0158"
        },
        {
          "segment_id": 159,
          "start": 800.07,
          "end": 804.39,
          "text": "اما معمولا تو جامعه هستن کسانی که احتیاج به قرض پیدا میکنن",
          "review_item_id": "segment-0159"
        },
        {
          "segment_id": 160,
          "start": 804.39,
          "end": 808.31,
          "text": "خب ما کسانی باشیم که به اونها قرض میدهیم",
          "review_item_id": "segment-0160"
        },
        {
          "segment_id": 161,
          "start": 808.31,
          "end": 815.23,
          "text": "در مجموع این شرایط چه به لحاظ فرهنگی، چه به لحاظ علم سواد مالی",
          "review_item_id": "segment-0161"
        },
        {
          "segment_id": 162,
          "start": 815.23,
          "end": 822.33,
          "text": "قرض گرفتن یه که کار نادرست و ناپسند در سواد مالی مطرحه",
          "review_item_id": "segment-0162"
        },
        {
          "segment_id": 163,
          "start": 822.33,
          "end": 830.55,
          "text": "اما در چند جا و با رعایت چند قاعده میتونیم قرض بگیریم و خودمون رو بدهکار بکنیم",
          "review_item_id": "segment-0163"
        },
        {
          "segment_id": 164,
          "start": 830.55,
          "end": 836.41,
          "text": "تو زندگی درسترین راه، لزومن کتاهترین راه و مستقیمترین راه نیست",
          "review_item_id": "segment-0164"
        },
        {
          "segment_id": 165,
          "start": 836.41,
          "end": 843.61,
          "text": "مثل این میمونه که ما توی مارپیچ حضور داریم و همه شیشه ها و دیوار ها رو خراب بکنیم و به انتها برسیم",
          "review_item_id": "segment-0165"
        },
        {
          "segment_id": 166,
          "start": 843.61,
          "end": 846.69,
          "text": "اتفاقاً باید قواعد و رایت بکنیم",
          "review_item_id": "segment-0166"
        },
        {
          "segment_id": 167,
          "start": 846.69,
          "end": 851.15,
          "text": "نه باید از رو نیمکت ها، از رو سر دانش آموزان بریم به معلم برسیم",
          "review_item_id": "segment-0167"
        },
        {
          "segment_id": 168,
          "start": 851.15,
          "end": 853.81,
          "text": "چون مستقیم ترین راه و کتاه ترین راهه",
          "review_item_id": "segment-0168"
        },
        {
          "segment_id": 169,
          "start": 853.81,
          "end": 858.19,
          "text": "بلکه باید از نیمکت بیاییم بیرون، اون راه رو رو تی بکنیم",
          "review_item_id": "segment-0169"
        },
        {
          "segment_id": 170,
          "start": 858.19,
          "end": 860.37,
          "text": "و بریم پشت میز معلم بیستیم",
          "review_item_id": "segment-0170"
        },
        {
          "segment_id": 171,
          "start": 860.37,
          "end": 864.35,
          "text": "یا توی مارپیش کاملاً قواعد و رایت بکنیم",
          "review_item_id": "segment-0171"
        },
        {
          "segment_id": 172,
          "start": 864.35,
          "end": 866.53,
          "text": "از بین اونا حرکت بکنیم",
          "review_item_id": "segment-0172"
        },
        {
          "segment_id": 173,
          "start": 866.53,
          "end": 870.53,
          "text": "و بعد به انتها برسیم آدم موفقی خواهیم بود",
          "review_item_id": "segment-0173"
        },
        {
          "segment_id": 174,
          "start": 870.53,
          "end": 874.45,
          "text": "قرض اولین راهیه که به ذهنمون میرسه",
          "review_item_id": "segment-0174"
        },
        {
          "segment_id": 175,
          "start": 874.45,
          "end": 877.27,
          "text": "کتاهترین راه و مستقیمترین راهه",
          "review_item_id": "segment-0175"
        },
        {
          "segment_id": 176,
          "start": 877.27,
          "end": 880.49,
          "text": "اما لزومن درستنین راه نیست",
          "review_item_id": "segment-0176"
        }
      ]
    }
