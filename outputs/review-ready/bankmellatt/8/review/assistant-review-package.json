        },
        {
          "segment_id": 185,
          "start": 791.63,
          "end": 794.15,
          "text": "باید ببینم حضینه ی فرصتش چیه",
          "review_item_id": "segment-0185"
        },
        {
          "segment_id": 186,
          "start": 794.15,
          "end": 797.95,
          "text": "ممکنه دارم یه چیزی رو از دست میدم که خیلی دوست داشته باشم",
          "review_item_id": "segment-0186"
        },
        {
          "segment_id": 187,
          "start": 798.69,
          "end": 805.65,
          "text": "تلخی از دست دادن فوتبال همواره باید کمتر از تلخی از دست دادن سینما باشه",
          "review_item_id": "segment-0187"
        },
        {
          "segment_id": 188,
          "start": 806.29,
          "end": 812.83,
          "text": "چون اگر تلخی از دست دادن سینما بیشتر باشه، خب میگم که سینما میرم",
          "review_item_id": "segment-0188"
        },
        {
          "segment_id": 189,
          "start": 812.83,
          "end": 817.63,
          "text": "اگر تلخی از دست دادن فوتبال بیشتر باشه، میگم میرم فوتبال بازی میکنم",
          "review_item_id": "segment-0189"
        },
        {
          "segment_id": 190,
          "start": 817.63,
          "end": 824.67,
          "text": "حضینه یه فرصت به ما نشون میده که صرفنی نیست که یه طبوی پولی داری پس میتونی اون کالا رو بخری",
          "review_item_id": "segment-0190"
        },
        {
          "segment_id": 191,
          "start": 824.67,
          "end": 830.35,
          "text": "باید ببینی چی رو هم از دست میدی، بلا من هیچ وقتی کالا رو با خودش مقایسه نمی کنن",
          "review_item_id": "segment-0191"
        },
        {
          "segment_id": 192,
          "start": 830.35,
          "end": 834.75,
          "text": "مثلا یه یخچال رو بله تو خرید مقایسه این رو میریم",
