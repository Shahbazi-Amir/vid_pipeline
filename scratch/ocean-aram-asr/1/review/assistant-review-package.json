{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 300.88,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 12.2,
          "text": "وقتی ما از اوتوبوس زندگی می افتیم پایین و دست و بالمون داغوم میشه و واقعیت زندگی اون سختی ها و دوشواری هاست، باید یه چرایی داشته باشیم",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 12.7,
          "end": 19.58,
          "text": "یه دلیلی برای زندگی کردن داشته باشیم که حاضر باشیم به خاطرش زندگی بکنیم",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 27.66,
          "end": 42.18,
          "text": "اگر بخوام اون چی که تو این مثلا بیست و یک سال رو جمع بکنم و کپسولش بکنم یا یه قاشوق اصلش بکنم و بدم به شما میگم که شخصیت شما چهار بعده اصلی دیدم",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 42.18,
          "end": 55.29,
          "text": "اولین بعد چیه؟ بهش میگم بعد معنا فرض کنید این یک مربعه و بعد اولش بعد معناست",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 55.29,
          "end": 61.15,
          "text": "باید معنا به ما چی میگه؟ به ما میگه که معموریت تو تو این هستی چیه؟",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 61.93,
          "end": 66.35,
          "text": "اول معموریتت، تو چرا داری زندگی میکنی؟ باید اینو کشف کنی",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 66.35,
          "end": 72.47,
          "text": "یه تنوری هست میگن این خمیره، این خمیر رو بخوری، خمیر آرزو رو بخوری، دل درد میگیری",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 72.47,
          "end": 77.61,
          "text": "یه تنوری هست بهش میگن تنور اسمارت شنیدین؟",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 78.49,
          "end": 84.31,
          "text": "این خمیر رو باید بذاری تو اون تنور بپذ نون بشه، بعد نون رو باید بخوری",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 84.31,
          "end": 93.59,
          "text": "یعنی مشخص باشه، قابل اندازگیری باشه، قابل دستیابی باشه از نظر تو",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 93.59,
          "end": 99.93,
          "text": "با زندگیت، با موسیقی زندگیت همه هنگ باشه و زماندار باشه",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 99.93,
          "end": 110.01,
          "text": "در چه تاریخی؟ من میخواهم عرشد فلان دانشگاه در فلان رشته، در فلان شهر، در فلان تاریخ",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 110.01,
          "end": 115.57,
          "text": "هدف باید باشه، باید دانش لازمون رو به دست بیارید",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 115.57,
          "end": 120.77,
          "text": "میشه بعد دوم زندگی شما، بعد علمی و بعد دانشی",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 120.77,
          "end": 126.51,
          "text": "اگر میخوای انسان رشدی آفتهی بشی، باید بعد دانشیت هم تکمیل بکنی",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 126.51,
          "end": 127.71,
          "text": "یه چیزهایی رو بدونی",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 127.71,
          "end": 131.83,
          "text": "چند تا نکته مهم داره بعد دانشی",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 131.83,
          "end": 134.49,
          "text": "یک، تفکر راه بردی",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 134.49,
          "end": 138.55,
          "text": "یعنی تفکری که شما رو بتونه به آینده ببره",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 138.55,
          "end": 141.31,
          "text": "و مسیرهای آینده رو پیشبینی بکنه",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 141.31,
          "end": 145.09,
          "text": "تفکر سیستمی، کلنگر باشی",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 146.41,
          "end": 149.07,
          "text": "یعنی همه رو در جمع ببینی",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 149.07,
          "end": 151.87,
          "text": "عجزای زندگیت نبینی",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 151.87,
          "end": 153.59,
          "text": "تفکر انتقادی",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 153.59,
          "end": 158.85,
          "text": "بتونی نقاد باشی موقعی که دانش رو به دست میاری",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 158.85,
          "end": 161.99,
          "text": "و در نهایت تفکر",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 161.99,
          "end": 165.53,
          "text": "یه پیشنهادی هم شما بدین، من ستا گفتم",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 165.53,
          "end": 180.65,
          "text": "چی؟ تفکر انتظایی؟ نه، نه، تفکر خلاق، خلاقیت بتونی به خرج بدی",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 180.65,
          "end": 185.27,
          "text": "علم، هیچ وقت منجر به رفتار نمیشه",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 185.27,
          "end": 192.55,
          "text": "یعنی شما دانش توحیدم داشته باشی، آدم موحدی نمیشی",
          "review_item_id": null
        },
        {
          "segment_id": 31,
          "start": 194.31,
          "end": 203.85,
          "text": "آفرین، یعنی بقیر از عقل باید یه درگیری اینجا وجود داشته باشه به نام قلب",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 203.85,
          "end": 213.67,
          "text": "که اون بشه یه گره خوردگی عقدی بین علم و احساس ایجاد میشه بهش میگن عقیده",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 213.67,
          "end": 218.99,
          "text": "بود احساسی شما باید تقویت بشه این بود ثومه وجود شماست",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 218.99,
          "end": 227.89,
          "text": "بود احساسی که باید گره بخوره با این بود علمی و وقتی این گره بخوره میتونه معجزه بکنه",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 227.89,
          "end": 238.01,
          "text": "میتونه رفتار شکل بده خب این هم بود احساسی ما معمولیتمونو شناختیم دانش لازمشو داریم",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 238.01,
          "end": 243.03,
          "text": "احساسمونم درگیر شده حالا بسم الله باید رفتار شکل بگیره",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 243.03,
          "end": 249.57,
          "text": "ما وقتی بی نهایت خواهیم، چی میتونه ما رو پر بکنه؟",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 249.57,
          "end": 252.37,
          "text": "یه بی نهایت میتونه ما رو پر بکنه",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 252.37,
          "end": 258.33,
          "text": "به خاطر همین هم هیچوقت از خدا نمیخواهیم ما رو به یک مقصد هدایت بکنه",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 258.33,
          "end": 267.46,
          "text": "از خدا میخواهیم که ما رو به یک راه هدایت بکنه",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 269.22,
          "end": 270.98,
          "text": "اهدنستراتل مستقیم",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 270.98,
          "end": 275.22,
          "text": "و این مستقیمه کتاه تری مسیر نیست",
          "review_item_id": "segment-0042"
        },
        {
          "segment_id": 43,
          "start": 275.22,
          "end": 276.42,
          "text": "راه درسته",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 278.98,
          "end": 300.88,
          "text": "بود مادی ما دو بخش خیلی جدی داره، یک جسم ما، دو بود مالی ما، پول، مانی، خب بود جسمی ما و بود مالی ما، این دوتا توانه اجرای معمولیت به ما میده",
          "review_item_id": "segment-0044"
        }
      ]
    }
  ]
}
