        },
        {
          "segment_id": 195,
          "start": 846.33,
          "end": 849.49,
          "text": "حضینه یه فرصت خرید یخچال چیه؟",
          "review_item_id": "segment-0195"
        },
        {
          "segment_id": 196,
          "start": 849.49,
          "end": 854.89,
          "text": "مثلا بعضی ها میگن که مثلا یه مثال خیلی مرسومش خرید ویلاست",
          "review_item_id": "segment-0196"
        },
        {
          "segment_id": 197,
          "start": 855.83,
          "end": 861.93,
          "text": "خب میگه من پول دارم یه ویلایی در شمال یا اطراف تهران یا اطراف محل وندگی میخرم",
          "review_item_id": "segment-0197"
        },
        {
          "segment_id": 198,
          "start": 861.93,
          "end": 864.77,
          "text": "که مثلا یه باخچهی داشته باشه",
