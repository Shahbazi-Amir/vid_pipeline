        },
        {
          "segment_id": 206,
          "start": 890.95,
          "end": 897.69,
          "text": "میگه اگر من ویلا بخرم، حزینه فرصتش اینه که دیگه همه جای دنیا، همه جای کشورم رو نمیتونم ببینم",
          "review_item_id": "segment-0206"
        },
        {
          "segment_id": 207,
          "start": 897.69,
          "end": 902.35,
          "text": "یا اگر من ویلا بخرم، خانومم هم همچنان باید اون ویلا کار بکنه",
          "review_item_id": "segment-0207"
        },
        {
          "segment_id": 208,
          "start": 902.35,
          "end": 905.57,
          "text": "یعنی باز دوباره آشپزی بکنه، نمیدونم رسیدگی بکنه",
