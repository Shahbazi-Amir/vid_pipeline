{
  "schema_version": 1,
  "source": "audio_and_whisper_only",
  "external_reference_used": false,
  "chunks": [
    {
      "id": 1,
      "start": 0.0,
      "end": 226.96,
      "segments": [
        {
          "segment_id": 1,
          "start": 0.0,
          "end": 19.1,
          "text": "شنیدید پول پول میاره؟ و حتماً هم دیدیم که پول پول میاره، اما چجوری؟ چرا یه عده ای که پول دارن همیشه پول دارتر میشن؟ و اونهایی که پولی در بساط ندارن، حی ارزاش پولشون هم کم میشه؟ مسئله اینجاست که پول رو به کار میمدردن",
          "review_item_id": "segment-0001"
        },
        {
          "segment_id": 2,
          "start": 28.94,
          "end": 35.52,
          "text": "سلام، خیلی خوبه که تا الان همراه من بودید و داریم گام به گام آموزه های سواد مالی رو جلو میریم",
          "review_item_id": "segment-0002"
        },
        {
          "segment_id": 3,
          "start": 35.52,
          "end": 42.02,
          "text": "تا اینجا پیش رفتیم که حزینه هامون رو به مدت سه ماه سفت میکنیم، اصناد و مداره که پشتیبان داریم",
          "review_item_id": "segment-0003"
        },
        {
          "segment_id": 4,
          "start": 42.02,
          "end": 47.5,
          "text": "و یه جاهایی هم کاهش حزینه داشتیم به تناصب زندگیمون و اونجوری که دوست داشتیم",
          "review_item_id": "segment-0004"
        },
        {
          "segment_id": 5,
          "start": 47.5,
          "end": 53.5,
          "text": "نه به معنی اینکه به خودمون ریاضت داده باشیم یا خصاصت به خرج داده باشیم",
          "review_item_id": "segment-0005"
        },
        {
          "segment_id": 6,
          "start": 53.5,
          "end": 60.74,
          "text": "بعد وارد این شدیم که به محض اینکه درامده بون رو کست میکنیم برای سه صندوق پول کنار میذاریم",
          "review_item_id": "segment-0006"
        },
        {
          "segment_id": 7,
          "start": 61.59,
          "end": 67.56,
          "text": "خب و نکتش این بود که پول کنار گذاشتن همانا و کاهش عرضش پول همان",
          "review_item_id": "segment-0007"
        },
        {
          "segment_id": 8,
          "start": 67.56,
          "end": 71.36,
          "text": "چی کار باید بکنیم؟ گفتیم این پول رو باید به کار بندازیم",
          "review_item_id": "segment-0008"
        },
        {
          "segment_id": 9,
          "start": 71.36,
          "end": 76.44,
          "text": "ما معمولا درامده من ناشی از اینه که ما خودمون رو به کار انداختیم",
          "review_item_id": "segment-0009"
        },
        {
          "segment_id": 10,
          "start": 76.44,
          "end": 81.14,
          "text": "کار کردیم، مهارت هامون رو به کار گرفتیم و درامد کست کردیم",
          "review_item_id": "segment-0010"
        },
        {
          "segment_id": 11,
          "start": 81.14,
          "end": 83.7,
          "text": "حالا وقتی اینه که پولمونم به کار بندازیم",
          "review_item_id": "segment-0011"
        },
        {
          "segment_id": 12,
          "start": 83.7,
          "end": 89.04,
          "text": "این که ما درامد من ناشی از کار باشه چند تا آسیب داره",
          "review_item_id": "segment-0012"
        },
        {
          "segment_id": 13,
          "start": 89.04,
          "end": 92.7,
          "text": "یکی این که به محضی این که کار نکنیم دیگه کسی به من پول نمیده",
          "review_item_id": "segment-0013"
        },
        {
          "segment_id": 14,
          "start": 92.7,
          "end": 97.82,
          "text": "خب واضحه وقتی یه دکتری مطبشو ببنده دیگه حق ویزیت هم نمیگیره",
          "review_item_id": "segment-0014"
        },
        {
          "segment_id": 15,
          "start": 97.82,
          "end": 104.26,
          "text": "یه کارمندی که استفا بده و در واقع ترک کار بکنه دیگه کسی بهش حقوق نمیده",
          "review_item_id": "segment-0015"
        },
        {
          "segment_id": 16,
          "start": 104.26,
          "end": 112.34,
          "text": "خب پس آسیب درامد ناشه از کار اینه که وقتی کار نکنی پول نمیگیری",
          "review_item_id": "segment-0016"
        },
        {
          "segment_id": 17,
          "start": 112.34,
          "end": 118.08,
          "text": "با توقف کار و فعالیت شغلی جریان درامدی هم منتوقف میشه",
          "review_item_id": "segment-0017"
        },
        {
          "segment_id": 18,
          "start": 118.08,
          "end": 120.32,
          "text": "اما سرمایه گذاری اینجوری نیست",
          "review_item_id": "segment-0018"
        },
        {
          "segment_id": 19,
          "start": 120.32,
          "end": 122.3,
          "text": "شما لازم نیست اصلا کار بکنی",
          "review_item_id": "segment-0019"
        },
        {
          "segment_id": 20,
          "start": 122.3,
          "end": 124.46,
          "text": "پول خودش برای شما کار میکنه",
          "review_item_id": "segment-0020"
        },
        {
          "segment_id": 21,
          "start": 124.46,
          "end": 126.34,
          "text": "حتی شبهایی که خوابی",
          "review_item_id": "segment-0021"
        },
        {
          "segment_id": 22,
          "start": 126.34,
          "end": 131.24,
          "text": "حتی زمانهایی که رفتی مسافرت و تفریح داری میکنی",
          "review_item_id": "segment-0022"
        },
        {
          "segment_id": 23,
          "start": 131.24,
          "end": 132.96,
          "text": "اون پول برای شما کار میکنه",
          "review_item_id": "segment-0023"
        },
        {
          "segment_id": 24,
          "start": 132.96,
          "end": 136.54,
          "text": "دومین آسیب درامد ناشی از شغل اینه که",
          "review_item_id": "segment-0024"
        },
        {
          "segment_id": 25,
          "start": 136.54,
          "end": 139.48,
          "text": "بلاخره یه سقفی داره، یه محدودیتی داره",
          "review_item_id": "segment-0025"
        },
        {
          "segment_id": 26,
          "start": 139.48,
          "end": 145.32,
          "text": "مثلا زمانیشو بگم شما یا من بیشتر از 11 ساعت که نمیتونیم کار بکنیم",
          "review_item_id": "segment-0026"
        },
        {
          "segment_id": 27,
          "start": 145.32,
          "end": 150.06,
          "text": "هر چقدر هم تلاش بکنیم در ایته فعالیت شغلیمون",
          "review_item_id": "segment-0027"
        },
        {
          "segment_id": 28,
          "start": 150.06,
          "end": 154.58,
          "text": "بلاخره یه سقفی داره و این سقف محدودیت ایجاد میکنه",
          "review_item_id": "segment-0028"
        },
        {
          "segment_id": 29,
          "start": 154.58,
          "end": 158.88,
          "text": "اما وقتی پول به کار بیفته وارد ارسه سرمایه گذاری بشه",
          "review_item_id": "segment-0029"
        },
        {
          "segment_id": 30,
          "start": 158.88,
          "end": 166.88,
          "text": "هیچ محدودیتی نداره، هرچقدر این پول به چرخه و سوداور بشه، پول رو به شما بر میگردونه",
          "review_item_id": "segment-0030"
        },
        {
          "segment_id": 31,
          "start": 166.88,
          "end": 176.1,
          "text": "یکی دیگه از آسیبهای درامد ناشیست شغل اینه که بلاخره یه روزی همه ای ما به یه زمانی میرسیم که بازنشست نمیشیم",
          "review_item_id": "segment-0031"
        },
        {
          "segment_id": 32,
          "start": 176.1,
          "end": 179.46,
          "text": "و ظرفیت درامدزاییمون هم کاهش پیدا میکنه",
          "review_item_id": "segment-0032"
        },
        {
          "segment_id": 33,
          "start": 179.46,
          "end": 182.3,
          "text": "یعنی دیگه اون حقوق رو به ما نمیدن",
          "review_item_id": "segment-0033"
        },
        {
          "segment_id": 34,
          "start": 182.3,
          "end": 187.24,
          "text": "و حتی کمتر از اون ببیجه با بحران هایی که صندوق هایی بازنشستگی داره",
          "review_item_id": "segment-0034"
        },
        {
          "segment_id": 35,
          "start": 187.24,
          "end": 190.9,
          "text": "یه حقوقی به ما میدن که کفاف زندگیمون رو نمیده",
          "review_item_id": "segment-0035"
        },
        {
          "segment_id": 36,
          "start": 190.9,
          "end": 198.92,
          "text": "تو دورانی که بعضی از پجویشان نشون داده که حضینه های زندگی تا چار برابر افضایش پیدا میکنه",
          "review_item_id": "segment-0036"
        },
        {
          "segment_id": 37,
          "start": 198.92,
          "end": 203.78,
          "text": "خانواده گسترده تر میشه، حضینه های درمانی اضافه میشه",
          "review_item_id": "segment-0037"
        },
        {
          "segment_id": 38,
          "start": 203.78,
          "end": 208.9,
          "text": "توقعات در واقع اجتماعی مثل بزرگ فامیل بودن ایجاد میشه",
          "review_item_id": "segment-0038"
        },
        {
          "segment_id": 39,
          "start": 208.9,
          "end": 213.7,
          "text": "کمک کردن به دیگران جدی تر میشه، حدایی که میبری جدی تر میشه",
          "review_item_id": "segment-0039"
        },
        {
          "segment_id": 40,
          "start": 213.7,
          "end": 217.88,
          "text": "بلابراین تا چار برابر حتی ممکنه هزینه ها افضایش پیدا بکنه",
          "review_item_id": "segment-0040"
        },
        {
          "segment_id": 41,
          "start": 217.88,
          "end": 223.24,
          "text": "این در حالیه که با توجه به این که دیگه مذایع شغلی هم آدم نداره تو دوره بازنشسته",
          "review_item_id": "segment-0041"
        },
        {
          "segment_id": 42,
          "start": 223.24,
          "end": 226.96,
          "text": "یه میگن تا پنجاه درصد انگار درامت کاش پیدا کرده",
          "review_item_id": "segment-0042"
        }
      ]
    },
    {
      "id": 2,
      "start": 227.7,
      "end": 475.38,
      "segments": [
        {
          "segment_id": 43,
          "start": 227.7,
          "end": 233.98,
          "text": "خب همه اینا ما رو میبره به سمت آینده سازی، به سمت به کار گرفتن پول",
          "review_item_id": "segment-0043"
        },
        {
          "segment_id": 44,
          "start": 233.98,
          "end": 237.74,
          "text": "پول رو به کار بیندازیم که بهش میگن سرمایه گذاری",
          "review_item_id": "segment-0044"
        },
        {
          "segment_id": 45,
          "start": 237.74,
          "end": 243.9,
          "text": "یعنی پولی که به کار میفته و در معرض خطر قرار میگیره رو بهش میگن سرمایه",
          "review_item_id": "segment-0045"
        },
        {
          "segment_id": 46,
          "start": 243.9,
          "end": 245.72,
          "text": "پولی که در حال کار کردنه",
          "review_item_id": "segment-0046"
        },
        {
          "segment_id": 47,
          "start": 245.72,
          "end": 251.5,
          "text": "خب اون صندوق هایی که گفتیم صندوق پسنداز کتاه مدت بلند مدت",
          "review_item_id": "segment-0047"
        },
        {
          "segment_id": 48,
          "start": 251.5,
          "end": 256.28,
          "text": "یا صندوق استراری باید وارد عرصه سرمایه گذاری بشه",
          "review_item_id": "segment-0048"
        },
        {
          "segment_id": 49,
          "start": 256.28,
          "end": 258.72,
          "text": "چرا ما باید سرمایه گذاری بکنیم؟",
          "review_item_id": "segment-0049"
        },
        {
          "segment_id": 50,
          "start": 258.72,
          "end": 262.5,
          "text": "یکی این که درامت های ناشی از شغل آسیب هایی داره",
          "review_item_id": "segment-0050"
        },
        {
          "segment_id": 51,
          "start": 262.5,
          "end": 269.88,
          "text": "دو این که ما ممکنه بخواییم از عرضش پولمون محافظت بکنیم",
          "review_item_id": "segment-0051"
        },
        {
          "segment_id": 52,
          "start": 270.62,
          "end": 275.24,
          "text": "به مهض این که میگیم پسنداز، به مهض این که پولی رو کنار بذاریم",
          "review_item_id": "segment-0052"
        },
        {
          "segment_id": 53,
          "start": 275.24,
          "end": 277.58,
          "text": "از عرضشش کاهش بیدان میکنه",
          "review_item_id": "segment-0053"
        },
        {
          "segment_id": 54,
          "start": 277.58,
          "end": 279.54,
          "text": "زور این پول کم میشه",
          "review_item_id": "segment-0054"
        },
        {
          "segment_id": 55,
          "start": 279.54,
          "end": 282.98,
          "text": "فرض کنید یه آجوری رو در نظر بگیرید از سرب",
          "review_item_id": "segment-0055"
        },
        {
          "segment_id": 56,
          "start": 282.98,
          "end": 284.98,
          "text": "عباد مشخصی داره",
          "review_item_id": "segment-0056"
        },
        {
          "segment_id": 57,
          "start": 284.98,
          "end": 288.84,
          "text": "خب، این یه وزنی داره، یه قدرتی داره",
          "review_item_id": "segment-0057"
        },
        {
          "segment_id": 58,
          "start": 288.84,
          "end": 294.88,
          "text": "در طول زمان تو شرایط تورمی، این عباد این آجوره حفظ میشه",
          "review_item_id": "segment-0058"
        },
        {
          "segment_id": 59,
          "start": 294.88,
          "end": 300.56,
          "text": "ولی زورش و انرژیش کم میشه، انگار که یه آجور پلاستیکیه",
          "review_item_id": "segment-0059"
        },
        {
          "segment_id": 60,
          "start": 301.12,
          "end": 305.94,
          "text": "اون موقع یه وزنی داشت، ولی وقتی آجور پلاستیکی بشه، وزنش کم میشه",
          "review_item_id": "segment-0060"
        },
        {
          "segment_id": 61,
          "start": 305.94,
          "end": 311.2,
          "text": "این یعنی تورم، یعنی عباد همون عباده، ولی دیگه زور نداره",
          "review_item_id": "segment-0061"
        },
        {
          "segment_id": 62,
          "start": 311.2,
          "end": 314.04,
          "text": "هزارتومنیه ما همون هزارتومنیه",
          "review_item_id": "segment-0062"
        },
        {
          "segment_id": 63,
          "start": 314.04,
          "end": 316.08,
          "text": "ولی دیگه زور نداره",
          "review_item_id": "segment-0063"
        },
        {
          "segment_id": 64,
          "start": 316.08,
          "end": 321.44,
          "text": "یه مثال واضحش از این که عرضش پول کاهش پیدا میکنه تو شرایط تورمی",
          "review_item_id": "segment-0064"
        },
        {
          "segment_id": 65,
          "start": 321.44,
          "end": 324.66,
          "text": "مقایسش مثلا با قیمت تلا یا سکه هست",
          "review_item_id": "segment-0065"
        },
        {
          "segment_id": 66,
          "start": 324.66,
          "end": 329.34,
          "text": "مثلا سال هشتاد سکه شست هزار تومن بوده",
          "review_item_id": "segment-0066"
        },
        {
          "segment_id": 67,
          "start": 329.34,
          "end": 334.5,
          "text": "این روزایی که داریم صحبت میکنیم سکه حدود ده ملیون یازده ملیونه",
          "review_item_id": "segment-0067"
        },
        {
          "segment_id": 68,
          "start": 334.5,
          "end": 342.1,
          "text": "خب یعنی زور شست هزار تومن سال هشتاد برابر با زور ده ملیونه الانه",
          "review_item_id": "segment-0068"
        },
        {
          "segment_id": 69,
          "start": 342.1,
          "end": 350.32,
          "text": "خب یعنی چقدر کاهش پیدا کرده؟ کمتر از یک صدوم این عرضش پول ما کاهش پیدا کرده",
          "review_item_id": "segment-0069"
        },
        {
          "segment_id": 70,
          "start": 350.32,
          "end": 352.16,
          "text": "دیگه اون قدرت رو نداره",
          "review_item_id": null
        },
        {
          "segment_id": 71,
          "start": 352.16,
          "end": 362.76,
          "text": "تورم اصولا یعنی چی؟ یعنی این که بخش واقعی اقتصاد با بخش عددی و حجم پول برابر نیست",
          "review_item_id": "segment-0071"
        },
        {
          "segment_id": 72,
          "start": 362.76,
          "end": 369.74,
          "text": "وقتی واقعی و این بخش واقعی و این بخش عددی برابر باشه تورم تقریبا کمه",
          "review_item_id": "segment-0072"
        },
        {
          "segment_id": 73,
          "start": 369.74,
          "end": 375.44,
          "text": "ولی وقتی بخش عددی ورم میکنه، حجم پول زیاد میشه، این ورم رو بهش میگن تورم",
          "review_item_id": "segment-0073"
        },
        {
          "segment_id": 74,
          "start": 375.44,
          "end": 385.58,
          "text": "دیگه ما به اعضای بیشتری از اون حجم پول به نسبت یک حجم واقعی اقتصاد وجود داره",
          "review_item_id": "segment-0074"
        },
        {
          "segment_id": 75,
          "start": 385.58,
          "end": 392.54,
          "text": "یعنی شما مثلا اگر یک واحد واقعیت اقتصادی بود، اینجام یک واحد عددی",
          "review_item_id": "segment-0075"
        },
        {
          "segment_id": 76,
          "start": 392.54,
          "end": 397.28,
          "text": "الان ده واحد عددی در برابر یک واحد واقعی اقتصاد",
          "review_item_id": "segment-0076"
        },
        {
          "segment_id": 77,
          "start": 397.28,
          "end": 403.12,
          "text": "این حجم پول افضایش پیدا کرده یعنی چی؟ یعنی عرضشش کاهش پیدا کرده",
          "review_item_id": "segment-0077"
        },
        {
          "segment_id": 78,
          "start": 403.12,
          "end": 407.6,
